# Database Configuration
DB_USER=postgres
DB_HOST=localhost
DB_NAME=biis_db
TEST_DB_NAME=biis_test
DB_PASSWORD=replace_with_your_local_password
DB_PORT=5432

# Server Configuration
PORT=5000
CLIENT_ORIGIN=http://localhost:5173

# Authentication Secret (IMPORTANT: Generate a secure random value)
ACCESS_TOKEN_SECRET=63ca1e7e4efe7c3822cee2f265e9e25f07a339bdafd3c8c36a28e1e3d6992318f6afff11463392582ee9dc1a0c8afa9b81215d8a3a6b69c9c265dbff1405a2a7

# Authentication Timeouts
ACCESS_TOKEN_EXPIRES_IN=15m
REFRESH_TOKEN_EXPIRES_IN=7d

# Bcrypt Configuration
BCRYPT_SALT_ROUNDS=12

# Cookie Configuration
REFRESH_COOKIE_NAME=refreshToken

# Environment
NODE_ENV=development

# Password reset mail (required only when sending real reset email)
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=
PASSWORD_RESET_URL=http://localhost:5173/reset-password
PASSWORD_RESET_EXPIRES_MINUTES=30
