{
  "name": "biis-server",
  "version": "1.0.0",
  "description": "Backend server for the BIIS 2.0 University Management System",
  "main": "src/server.js",
  "scripts": {
    "test": "node test/helpers/check-test-database.js && node --test",
    "test:auth": "node test/helpers/check-test-database.js && node --test test/auth/auth.test.js",
    "test:password-reset": "node test/helpers/check-test-database.js && node --test test/auth/password-reset.test.js",
    "test:admin-bootstrap": "node test/helpers/check-test-database.js && node --test test/admin/admin-bootstrap.test.js",
    "test:admin-management": "node test/helpers/check-test-database.js && node --test test/admin/admin-management.test.js",
    "admin:create": "node scripts/create-admin.js",
    "admin:reset": "node scripts/reset-admin.js",
    "db:seed-buet-departments": "node scripts/seed-buet-departments.js",
    "db:import-buet-teachers": "node scripts/import-buet-teachers.js",
    "dev": "nodemon src/server.js",
    "start": "node src/server.js",
    "db:init": "node db/init.js",
    "seed:demo": "node scripts/seed-demo.js",
    "demo:api": "node scripts/demo-api.js",
    "test": "node test/helpers/check-test-database.js && node --test --test-concurrency=1",
    "test:auth": "node test/helpers/check-test-database.js && node --test --test-concurrency=1 test/auth/auth.test.js",
    "test:password-change": "node test/helpers/check-test-database.js && node --test --test-concurrency=1 test/auth/password-change.test.js",
    "test:password-reset": "node test/helpers/check-test-database.js && node --test --test-concurrency=1 test/auth/password-reset.test.js",
    "test:admin-bootstrap": "node test/helpers/check-test-database.js && node --test --test-concurrency=1 test/admin/admin-bootstrap.test.js",
    "test:admin-management": "node test/helpers/check-test-database.js && node --test --test-concurrency=1 test/admin/admin-management.test.js",
    "test:academic": "node test/helpers/check-test-database.js && node --test --test-concurrency=1 test/academic/academic-management.test.js",
    "test:database-safety": "node --test --test-concurrency=1 test/database/database-safety.test.js"
  },
  "keywords": [
    "university-management",
    "dbms",
    "postgresql",
    "express",
    "rest-api"
  ],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "dependencies": {
    "bcrypt": "^6.0.0",
    "cheerio": "^1.2.0",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "express-rate-limit": "^8.6.2",
    "express-validator": "^7.3.2",
    "jsonwebtoken": "^9.0.3",
    "nodemailer": "^9.0.5",
    "pg": "^8.23.0",
    "readline-sync": "^1.4.10"
  },
  "devDependencies": {
    "nodemon": "^3.1.14",
    "supertest": "^7.2.2"
  }
}